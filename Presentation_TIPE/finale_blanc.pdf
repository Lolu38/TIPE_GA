/Title (def _check_track_collision_gpu\(self\) -> torch.Tensor:     if self.track_type == 'angular':       in_outer = self._inside_polygon_gpu\(         self.pos, self.outer_poly, self.outer_poly_next       \)       in_inner = self._inside_polygon_gpu\(         self.pos, self.inner_poly, self.inner_poly_next       \)       # Sur le circuit = dans outer ET hors inner       return ~\(in_outer & ~in_inner\) # \(N,\) bool)
